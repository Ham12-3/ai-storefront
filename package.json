{
  "name": "ai-storefront",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "embeddings:enable": "tsx scripts/configure-sanity-embeddings.ts enable",
    "embeddings:status": "tsx scripts/check-sanity-embeddings.ts",
    "embeddings:update-projection": "tsx scripts/configure-sanity-embeddings.ts update",
    "analytics:seed": "tsx scripts/seed-analytics.ts",
    "analytics:worker": "tsx scripts/process-analytics-jobs.ts",
    "analytics:aggregate": "tsx scripts/aggregate-analytics.ts",
    "analytics:retention": "tsx scripts/apply-retention-policy.ts",
    "analytics:backfill-sentiment": "tsx scripts/backfill-sentiment.ts",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sanity/vision": "6.9.2",
    "@sanity/visual-editing": "6.0.4",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "13.3.3",
    "openai": "7.4.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "sanity": "6.9.2",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
